<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>NET CORE - @ViewData["Title"]</title>
    <!-- Bootstrap CSS CDN -->
    <link href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
    <!-- Thanh điều hướng Header/Navbar -->
    <nav class="navbar navbar-inverse">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">NET CORE</a>
            <ul class="nav navbar-nav">
                <li class="active"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                <li><a asp-controller="Home" asp-action="About">Giới thiệu</a></li>
                <li><a asp-controller="Home" asp-action="Contact">Liên hệ</a></li>
                <li><a asp-controller="Book" asp-action="Index">Sách</a></li>
            </ul>
        </div>
    </nav>

    <!-- Nội dung động của từng View sẽ nhúng vào đây -->
    <div class="container">
        @RenderBody()
    </div>

    <!-- Script thư viện jQuery & Bootstrap -->
    <script src="https://code.jquery.com/jquery.min.js"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/js/bootstrap.min.js"></script>

    <!-- Cho phép nhúng mã Script riêng từ từng View -->
    @RenderSection("Scripts", required: false)
</body>
</html>