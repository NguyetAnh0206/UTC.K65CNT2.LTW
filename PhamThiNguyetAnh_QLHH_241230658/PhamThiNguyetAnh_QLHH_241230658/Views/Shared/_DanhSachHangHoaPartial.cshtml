@model IEnumerable<PhamThiNguyetAnh_QLHH_241230658.Models.HangHoa>
@if (Model != null && Model.Any())
{
	<div class="section group">
		@foreach (var hh in Model)
		{
			<div class="grid_1_of_4 images_1_of_4">
				<a href="#"><img src="~/images/@(hh.Anh ?? "feature-pic1.jpg")" alt="@hh.TenHang" /></a>
				<h2>@(hh.TenHang ?? "")</h2>
				<div class="price-details">
					<div class="price-number">
						<p><span class="rupees">@hh.Gia</span></p>
					</div>
					<div class="add-cart">
						<h4><a href="#">Add to Cart</a></h4>
					</div>
					<div class="clear"></div>
				</div>
			</div>
		}
		<div class="clear"></div>
	</div>
}
else
{
	<p>Không có hàng hóa nào phù hợp.</p>
}
