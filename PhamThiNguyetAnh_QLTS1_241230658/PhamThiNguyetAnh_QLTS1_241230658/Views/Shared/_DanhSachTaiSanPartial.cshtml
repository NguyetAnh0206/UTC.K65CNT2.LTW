@model IEnumerable<PhamThiNguyetAnh_QLTS1_241230658.Models.TaiSan>
<div class="grid">
    @foreach (var ts in Model)
    {
        <div class="asset-card">
            <a href="#"><img src="~/images/@ts.Anh" alt="@ts.TenTs" /></a>
            <h2>@ts.TenTs</h2>
            <div class="asset-foot">
                <span class="price">@ts.NguyenGia tr</span>
                <button type="button" class="btn-buy">Chi tiết</button>
            </div>
        </div>
    }
</div>