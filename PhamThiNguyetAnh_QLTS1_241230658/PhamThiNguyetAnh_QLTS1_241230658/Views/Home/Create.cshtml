@model PhamThiNguyetAnh_QLTS1_241230658.Models.TaiSan
@{
    ViewData["Title"] = "Thêm tài sản mới";
}
<main class="main">
    <div class="container">
        <div class="section-head">
            <h3>THÊM TÀI SẢN MỚI</h3>
            <a asp-controller="Home" asp-action="Index">&lsaquo; Quay lại trang chủ</a>
        </div>

        <form asp-action="Create" method="post" style="max-width: 520px; margin: 20px 0;">
            @Html.AntiForgeryToken()

            <div style="margin-bottom: 14px;">
                <label asp-for="MaLoai" style="display: block; font-weight: 600; margin-bottom: 4px;">Loại tài sản</label>
                <select asp-for="MaLoai" asp-items="ViewBag.MaLoai" style="width: 100%; padding: 8px;">
                    <option value="">-- Chọn loại tài sản --</option>
                </select>
                <span asp-validation-for="MaLoai" style="color: red; font-size: 13px;"></span>
            </div>

            <div style="margin-bottom: 14px;">
                <label asp-for="TenTs" style="display: block; font-weight: 600; margin-bottom: 4px;">Tên tài sản</label>
                <input asp-for="TenTs" type="text" style="width: 100%; padding: 8px;" />
                <span asp-validation-for="TenTs" style="color: red; font-size: 13px;"></span>
            </div>

            <div style="margin-bottom: 14px;">
                <label asp-for="NguyenGia" style="display: block; font-weight: 600; margin-bottom: 4px;">Nguyên giá (triệu)</label>
                <input asp-for="NguyenGia" type="text" style="width: 100%; padding: 8px;" />
                <span asp-validation-for="NguyenGia" style="color: red; font-size: 13px;"></span>
            </div>

            <div style="margin-bottom: 16px;">
                <label asp-for="Anh" style="display: block; font-weight: 600; margin-bottom: 4px;">Tên file ảnh</label>
                <input asp-for="Anh" type="text" style="width: 100%; padding: 8px;" />
                <span asp-validation-for="Anh" style="color: red; font-size: 13px;"></span>
            </div>

            <button type="submit" class="btn-buy" style="padding: 10px 24px; cursor: pointer;">Create</button>
        </form>
    </div>
</main>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}