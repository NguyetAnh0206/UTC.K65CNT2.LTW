@model IEnumerable<ptna.buoi07_tren_lop.Models.PtnaMember>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.PtnaUserName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PtnaPassword)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PtnaEmail)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PtnaPhone)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.PtnaUserName)
            </td>
            <td>
                @Html.DisplayFor(model => item.PtnaPassword)
            </td>
            <td>
                @Html.DisplayFor(model => item.PtnaEmail)
            </td>
            <td>
                @Html.DisplayFor(model => item.PtnaPhone)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
